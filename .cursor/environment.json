{
  "name": "WAC Origin Cost Desk",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "npm ci",
  "terminals": [
    {
      "name": "Vite",
      "command": "npm run dev -- --host 0.0.0.0 --port 5174",
      "description": "Origin Cost Desk preview server (port 5174). Open /origin-cost-desk."
    }
  ],
  "ports": [
    {
      "name": "Origin Cost Desk",
      "port": 5174
    }
  ]
}
